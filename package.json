{
  "name": "fini",
  "private": true,
  "version": "0.3.19",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test:unit": "jest --runInBand",
    "test:e2e": "make e2e-headed",
    "test:e2e:ci": "if [ \"$FINI_E2E_CONTAINER_RUNNER\" = \"1\" ]; then npx playwright test --config specs/e2e/playwright.config.ts --project cli --project ui --project multi-device; else CI=1 make pr-gate-e2e; fi",
    "test:e2e:android": "node scripts/e2e-android.mts",
    "test:e2e:windows": "npx playwright test --config specs/e2e/playwright.config.ts --project device-support",
    "test:e2e:smoke": "npx playwright test --config specs/e2e/playwright.config.ts --grep @smoke",
    "gate:fe-unit": "node scripts/ci-gate.mts fe-unit",
    "gate:be-compile": "node scripts/ci-gate.mts be-compile",
    "gate:be-unit": "node scripts/ci-gate.mts be-unit",
    "gate:e2e:build-image": "node scripts/ci-gate.mts e2e-build-image",
    "gate:e2e:run": "node scripts/ci-gate.mts e2e-run",
    "gate:e2e:artifacts": "node scripts/ci-gate.mts e2e-artifacts",
    "gate:e2e:cleanup": "node scripts/ci-gate.mts e2e-cleanup",
    "build:android:e2e": "node scripts/with-devtools-capability.mts npm run tauri android build -- --features ui-plane,devtools --ci --debug --apk --target x86_64",
    "build:windows:e2e": "node scripts/with-devtools-capability.mts npm run tauri build -- --debug --features ui-plane,devtools --no-bundle -- --bin fini-app",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "daisyui": "^5.5.19",
    "pinia": "^3.0.4",
    "vue": "^3.5.13",
    "vue-i18n": "^11.3.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@playwright/test": "^1.51.0",
    "@srsholmes/tauri-playwright": "^0.2.2",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/cli": "^2.11.0",
    "@types/jest": "^29.5.14",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/vue3-jest": "^29.2.6",
    "babel-jest": "^29.7.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "tailwindcss": "^4.2.1",
    "ts-jest": "^29.4.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26"
  }
}
