# The Linux image (docs/container.md).
#
#   build  Rust, Node and the -dev packages for the desktop app (glibc), the
#          static musl CLI and the unit tests.
#   e2e        build + Playwright Chromium, Xvfb and the GUI runtime
#              libraries for the desktop e2e tests.
#   cli-build  build + the static musl CLI (x86_64 only).
#   runtime    bookworm-slim with only the CLI: the release runtime image of
#              the `fini` CLI, published to GHCR.
#
# Build from the repo root (docker: the same command, without --layers):
#   podman build --layers -f containers/linux/Containerfile --target build .
#   podman build --layers -f containers/linux/Containerfile --target runtime .
#
# The repo is mounted at run time. Only the e2e stage (package-lock.json, for
# the Playwright version) and the cli-build stage (the Rust inputs of the CLI)
# copy files from it.

FROM docker.io/library/debian:bookworm-slim AS build

# Pin the minor version. The build gets the newest patch.
ARG RUST_VERSION=1.91
ARG NODE_MAJOR=24

# A build from scratch gains nothing from incremental files, and line tables
# are enough for test panics. Both keep the build inside the disk of the CI
# runner.
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH \
    CARGO_INCREMENTAL=0 \
    CARGO_PROFILE_DEV_DEBUG=line-tables-only

# The -dev packages are the ones of the Rust stages in the old Dockerfile and
# of the Linux jobs in ci.yml, plus libxdo-dev and libssl-dev from the Tauri
# prerequisites for Debian. file, patchelf and xdg-utils are for the Tauri
# bundles (AppImage, deb, rpm). musl-tools gives musl-gcc for the static CLI.
RUN set -eux; \
    apt-get update -o Acquire::Retries=5; \
    apt-get install -y -o Acquire::Retries=5 --no-install-recommends \
      ca-certificates curl git file xz-utils \
      build-essential pkg-config musl-tools \
      libasound2-dev libwebkit2gtk-4.1-dev libappindicator3-dev librsvg2-dev \
      libxdo-dev libssl-dev patchelf xdg-utils; \
    install -d -m 0755 /etc/apt/keyrings; \
    curl -fsSL --retry 5 -o /etc/apt/keyrings/nodesource.asc \
      https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key; \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.asc] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
      > /etc/apt/sources.list.d/nodesource.list; \
    apt-get update -o Acquire::Retries=5; \
    apt-get install -y -o Acquire::Retries=5 --no-install-recommends nodejs; \
    rm -rf /var/lib/apt/lists/*

# The image builds on x86_64 and on arm64 (the arm64 desktop app). The musl
# target is for the x86_64 CLI only. rustup-init is checked against its
# published SHA-256.
RUN set -eux; \
    arch="$(uname -m)"; \
    url="https://static.rust-lang.org/rustup/dist/${arch}-unknown-linux-gnu/rustup-init"; \
    curl -fsSL --retry 5 -o /tmp/rustup-init "$url"; \
    echo "$(curl -fsSL --retry 5 "$url.sha256" | cut -d' ' -f1)  /tmp/rustup-init" | sha256sum -c -; \
    chmod +x /tmp/rustup-init; \
    targets=; \
    if [ "$arch" = x86_64 ]; then targets="--target x86_64-unknown-linux-musl"; fi; \
    /tmp/rustup-init -y --no-modify-path --profile minimal \
      --default-toolchain "$RUST_VERSION" $targets; \
    rm /tmp/rustup-init; \
    rm -rf "$CARGO_HOME/registry"; \
    rustc --version; cargo --version

# linuxdeploy (the AppImage bundle) is an AppImage. A container has no FUSE,
# so it must extract itself and run.
ENV APPIMAGE_EXTRACT_AND_RUN=1

# CI mounts the repo here.
WORKDIR /work

FROM build AS e2e

# The GUI runtime libraries and Xvfb of the old dev-runner stage. Most of
# the libraries come with the -dev packages of the build stage already.
RUN set -eux; \
    apt-get update -o Acquire::Retries=5; \
    apt-get install -y -o Acquire::Retries=5 --no-install-recommends \
      jq \
      libglib2.0-0 libnss3 libnspr4 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 \
      libcups2 libx11-6 libxcomposite1 libxdamage1 libxext6 libxfixes3 \
      libxrandr2 libxkbcommon0 libpango-1.0-0 libcairo2 libgbm1 \
      fonts-liberation xvfb xauth dbus; \
    rm -rf /var/lib/apt/lists/*

# Put the browsers outside $HOME, so that the Playwright of the mounted repo
# finds them for each user.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright \
    FINI_E2E_CONTAINER_RUNNER=1 \
    TZ=UTC

# Install the Chromium of the Playwright version in package-lock.json. This
# layer is built again only when the lock file changes.
COPY package-lock.json /tmp/package-lock.json
RUN set -eux; \
    version="$(jq -r '.packages["node_modules/playwright"].version' /tmp/package-lock.json)"; \
    test "$version" != null; \
    npx --yes "playwright@$version" install chromium; \
    rm -rf /tmp/package-lock.json /root/.npm

FROM build AS cli-build

# Only the files that the CLI build reads, so that a change in the frontend
# or in the desktop app files does not build the CLI again.
COPY src-tauri/Cargo.toml src-tauri/Cargo.lock src-tauri/build.rs ./src-tauri/
COPY src-tauri/patches ./src-tauri/patches
COPY src-tauri/migrations ./src-tauri/migrations
COPY src-tauri/keys ./src-tauri/keys
COPY src-tauri/src ./src-tauri/src

RUN set -eux; \
    cargo build --manifest-path src-tauri/Cargo.toml --locked --release \
      --bin fini --features cli-plane --target x86_64-unknown-linux-musl; \
    cp src-tauri/target/x86_64-unknown-linux-musl/release/fini /usr/local/bin/fini; \
    rm -rf src-tauri/target "$CARGO_HOME/registry" "$CARGO_HOME/git"

FROM docker.io/library/debian:bookworm-slim AS runtime

# The CLI is static, so the image needs no libraries. ca-certificates is for
# the HTTPS calls of the CLI (for example the CLI update).
RUN set -eux; \
    apt-get update -o Acquire::Retries=5; \
    apt-get install -y -o Acquire::Retries=5 --no-install-recommends ca-certificates; \
    rm -rf /var/lib/apt/lists/*

COPY --from=cli-build /usr/local/bin/fini /usr/local/bin/fini

ENV XDG_DATA_HOME=/data
VOLUME ["/data"]
WORKDIR /data

ENTRYPOINT ["/usr/local/bin/fini"]
